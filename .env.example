# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)
# GitHub Actions에서는 저장소 Settings → Secrets and variables → Actions에 같은 이름으로 등록하세요.

# Claude API 키 (기사 문장 작성용). 없으면 템플릿 문장으로 기사를 만듭니다.
ANTHROPIC_API_KEY=

# 한국은행 ECOS API 키 (환율). https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# 공공데이터포털 서비스 키 (금융위원회_지수시세정보). https://www.data.go.kr/
DATA_GO_KR_KEY=
